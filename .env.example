# ===============================================================================
# SOLIQLY ENVIRONMENT CONFIGURATION TEMPLATE
# ===============================================================================

# Environment State
NODE_ENV=development
ENVIRONMENT=local

# Application Endpoints
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
API_V1_PREFIX=/api/v1

# Database Configuration (PostgreSQL 16 + pgvector)
POSTGRES_USER=soliqly
POSTGRES_PASSWORD=soliqly
POSTGRES_DB=soliqly_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://soliqly:soliqly@localhost:5432/soliqly_dev

# Cache & Message Broker (Redis 7.x)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO Local / Cloudflare R2 Production)
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
R2_BUCKET_NAME=soliqly-reports-dev

# Security & JWT Tokens
JWT_SECRET_KEY=change-this-to-a-secure-random-64-character-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Third-Party AI Services (Server-Side Only)
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-google-gemini-api-key-here

# Logging & Telemetry
LOG_LEVEL=INFO
SENTRY_DSN=
